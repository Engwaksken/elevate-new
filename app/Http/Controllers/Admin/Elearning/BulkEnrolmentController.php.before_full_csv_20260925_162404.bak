<?php

namespace App\Http\Controllers\Admin\Elearning;

use App\Http\Controllers\Controller;
use App\Models\Cohort;
use App\Models\Course;
use App\Models\Enrolment;
use App\Models\User;
use Carbon\Carbon;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;
use Symfony\Component\HttpFoundation\StreamedResponse;

class BulkEnrolmentController extends Controller
{
    /**
     * CSV columns supported by the importer.
     *
     * id / created_at / updated_at are included in the downloadable template
     * because they are table columns, but they are intentionally ignored on
     * import to avoid primary-key collisions and forged audit timestamps.
     *
     * email is an import helper, not an enrolments table column. It lets an
     * administrator identify a participant without looking up user_id.
     */
    private const CSV_HEADERS = [
        'id',
        'course_id',
        'user_id',
        'email',
        'cohort_id',
        'status',
        'enrolled_at',
        'started_at',
        'completed_at',
        'progress_percent',
        'final_score',
        'created_at',
        'updated_at',
    ];

    private const ALLOWED_STATUSES = [
        'enrolled',
        'in_progress',
        'completed',
        'withdrawn',
        'failed',
    ];

    public function create()
    {
        return view('admin.elearning.bulk-enrolment.create', [
            'courses' => Course::query()->orderBy('title')->get(),
            'cohorts' => Cohort::query()->orderBy('name')->get(),
            'stats' => [
                'courses' => Course::count(),
                'participants' => User::where('user_type', 'participant')->count(),
                'enrolments' => Enrolment::count(),
                'completed' => Enrolment::where('status', 'completed')->count(),
            ],
        ]);
    }

    public function template(): StreamedResponse
    {
        return response()->streamDownload(function (): void {
            $handle = fopen('php://output', 'w');

            // Excel-friendly UTF-8 CSV.
            fwrite($handle, "\xEF\xBB\xBF");

            fputcsv($handle, self::CSV_HEADERS);

            // Example row. System-managed columns are left blank.
            fputcsv($handle, [
                '',                         // id - ignored
                '1',                        // course_id
                '',                         // user_id
                'participant@example.com',  // email helper
                '',                         // cohort_id
                'enrolled',                 // status
                date('Y-m-d H:i:s'),        // enrolled_at
                '',                         // started_at
                '',                         // completed_at
                '0',                        // progress_percent
                '',                         // final_score
                '',                         // created_at - ignored
                '',                         // updated_at - ignored
            ]);

            fclose($handle);
        }, 'elevateher360_bulk_enrolment_full_template.csv', [
            'Content-Type' => 'text/csv; charset=UTF-8',
            'Cache-Control' => 'no-store, no-cache, must-revalidate',
        ]);
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'file' => ['required', 'file', 'mimes:csv,txt', 'max:10240'],
            'course_id' => ['nullable', 'exists:courses,id'],
            'cohort_id' => ['nullable', 'exists:cohorts,id'],
        ]);

        $path = $request->file('file')->getRealPath();
        $handle = fopen($path, 'r');

        if (! $handle) {
            throw ValidationException::withMessages([
                'file' => 'The CSV file could not be opened.',
            ]);
        }

        $header = fgetcsv($handle);

        if (! $header) {
            fclose($handle);

            throw ValidationException::withMessages([
                'file' => 'The CSV file is empty.',
            ]);
        }

        // Remove UTF-8 BOM and normalise headers.
        $header = array_map(function ($value) {
            $value = trim((string) $value);
            $value = preg_replace('/^\xEF\xBB\xBF/', '', $value);

            return strtolower($value);
        }, $header);

        $unknown = array_values(array_diff(
            $header,
            self::CSV_HEADERS
        ));

        if ($unknown) {
            fclose($handle);

            throw ValidationException::withMessages([
                'file' => 'Unknown CSV column(s): '.implode(', ', $unknown).'. Please use the downloadable template.',
            ]);
        }

        if (! in_array('user_id', $header, true) && ! in_array('email', $header, true)) {
            fclose($handle);

            throw ValidationException::withMessages([
                'file' => 'The CSV must contain user_id or email.',
            ]);
        }

        $created = 0;
        $updated = 0;
        $skipped = 0;
        $failed = [];
        $rowNumber = 1;

        while (($values = fgetcsv($handle)) !== false) {
            $rowNumber++;

            // Ignore completely blank rows.
            if (count(array_filter($values, fn ($value) => trim((string) $value) !== '')) === 0) {
                continue;
            }

            $values = array_pad($values, count($header), null);
            $row = array_combine($header, array_slice($values, 0, count($header)));

            try {
                $result = DB::transaction(function () use ($row, $data) {
                    $user = $this->resolveUser($row);

                    $courseId = $this->nullableInt($row['course_id'] ?? null)
                        ?? ($data['course_id'] ?? null);

                    if (! $courseId || ! Course::whereKey($courseId)->exists()) {
                        throw ValidationException::withMessages([
                            'course_id' => 'A valid course_id is required.',
                        ]);
                    }

                    $cohortId = $this->nullableInt($row['cohort_id'] ?? null);

                    if ($cohortId === null) {
                        $cohortId = $data['cohort_id'] ?? null;
                    }

                    if ($cohortId !== null && ! Cohort::whereKey($cohortId)->exists()) {
                        throw ValidationException::withMessages([
                            'cohort_id' => 'The cohort_id does not exist.',
                        ]);
                    }

                    $status = trim((string) ($row['status'] ?? '')) ?: 'enrolled';

                    if (! in_array($status, self::ALLOWED_STATUSES, true)) {
                        throw ValidationException::withMessages([
                            'status' => 'Status must be one of: '.implode(', ', self::ALLOWED_STATUSES).'.',
                        ]);
                    }

                    $progress = $this->nullableDecimal($row['progress_percent'] ?? null);

                    if ($progress === null) {
                        $progress = 0.00;
                    }

                    if ($progress < 0 || $progress > 100) {
                        throw ValidationException::withMessages([
                            'progress_percent' => 'Progress percent must be between 0 and 100.',
                        ]);
                    }

                    $finalScore = $this->nullableDecimal($row['final_score'] ?? null);

                    if ($finalScore !== null && ($finalScore < 0 || $finalScore > 100)) {
                        throw ValidationException::withMessages([
                            'final_score' => 'Final score must be between 0 and 100.',
                        ]);
                    }

                    $payload = [
                        'cohort_id' => $cohortId,
                        'status' => $status,
                        'enrolled_at' => $this->nullableDate($row['enrolled_at'] ?? null) ?? now(),
                        'started_at' => $this->nullableDate($row['started_at'] ?? null),
                        'completed_at' => $this->nullableDate($row['completed_at'] ?? null),
                        'progress_percent' => $progress,
                        'final_score' => $finalScore,
                    ];

                    $enrolment = Enrolment::query()->firstOrNew([
                        'course_id' => $courseId,
                        'user_id' => $user->id,
                    ]);

                    $wasNew = ! $enrolment->exists;

                    $enrolment->fill($payload);
                    $enrolment->save();

                    return $wasNew ? 'created' : 'updated';
                });

                if ($result === 'created') {
                    $created++;
                } else {
                    $updated++;
                }
            } catch (\Throwable $e) {
                $skipped++;

                $message = $e instanceof ValidationException
                    ? collect($e->errors())->flatten()->first()
                    : $e->getMessage();

                $failed[] = "Row {$rowNumber}: {$message}";
            }
        }

        fclose($handle);

        $message = "{$created} enrolment(s) created, {$updated} updated";

        if ($skipped > 0) {
            $message .= ", {$skipped} row(s) skipped";
        }

        return back()
            ->with('success', $message.'.')
            ->with('bulk_import_errors', array_slice($failed, 0, 50));
    }

    private function resolveUser(array $row): User
    {
        $userId = $this->nullableInt($row['user_id'] ?? null);
        $email = trim((string) ($row['email'] ?? ''));

        $user = null;

        if ($userId) {
            $user = User::find($userId);
        }

        if (! $user && $email !== '') {
            $user = User::where('email', $email)->first();
        }

        if (! $user) {
            throw ValidationException::withMessages([
                'user_id' => 'Participant not found using the supplied user_id/email.',
            ]);
        }

        return $user;
    }

    private function nullableInt(mixed $value): ?int
    {
        $value = trim((string) $value);

        if ($value === '') {
            return null;
        }

        if (! ctype_digit($value)) {
            throw ValidationException::withMessages([
                'csv' => "Expected an integer but received '{$value}'.",
            ]);
        }

        return (int) $value;
    }

    private function nullableDecimal(mixed $value): ?float
    {
        $value = trim((string) $value);

        if ($value === '') {
            return null;
        }

        if (! is_numeric($value)) {
            throw ValidationException::withMessages([
                'csv' => "Expected a number but received '{$value}'.",
            ]);
        }

        return (float) $value;
    }

    private function nullableDate(mixed $value): ?Carbon
    {
        $value = trim((string) $value);

        if ($value === '') {
            return null;
        }

        try {
            return Carbon::parse($value);
        } catch (\Throwable $e) {
            throw ValidationException::withMessages([
                'csv' => "Invalid date/time '{$value}'. Use YYYY-MM-DD or YYYY-MM-DD HH:MM:SS.",
            ]);
        }
    }
}
