<?php

namespace App\Services;

use App\Models\SystemSetting;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Crypt;
use Illuminate\Support\Facades\Schema;
use RuntimeException;
use Throwable;

class SettingsService
{
    public function get(string $key, $default = null)
    {
        /*
         * Some test environments use an in-memory SQLite database without
         * running the application's full settings migrations first.
         *
         * Global/web middleware may call SettingsService before the test has
         * created system_settings. In that case settings must gracefully fall
         * back to the supplied default rather than breaking every request.
         */
        try {
            if (! Schema::hasTable('system_settings')) {
                return $default;
            }
        } catch (Throwable $e) {
            return $default;
        }

        try {
            return Cache::remember(
                "setting:{$key}",
                300,
                function () use ($key, $default) {
                    $setting = SystemSetting::query()
                        ->where('key', $key)
                        ->first();

                    return $setting
                        ? $setting->typed_value
                        : $default;
                }
            );
        } catch (Throwable $e) {
            /*
             * Reading a non-critical platform setting should never take down
             * the application. This also protects bootstrap/maintenance mode
             * while migrations are being deployed.
             */
            report($e);

            return $default;
        }
    }

    public function set(
        string $key,
        $value,
        string $type = 'string',
        string $group = 'general',
        bool $public = false,
        bool $encrypted = false
    ): SystemSetting {
        try {
            if (! Schema::hasTable('system_settings')) {
                throw new RuntimeException(
                    'The system_settings table is not available. Run the application migrations before saving settings.'
                );
            }
        } catch (RuntimeException $e) {
            throw $e;
        } catch (Throwable $e) {
            throw new RuntimeException(
                'Unable to access the system settings table.',
                0,
                $e
            );
        }

        $stored = $type === 'json'
            ? json_encode($value)
            : (string) $value;

        if ($encrypted && $stored !== '') {
            $stored = Crypt::encryptString($stored);
        }

        $setting = SystemSetting::updateOrCreate(
            ['key' => $key],
            [
                'value' => $stored,
                'type' => $type,
                'group' => $group,
                'is_public' => $public,
                'is_encrypted' => $encrypted,
            ]
        );

        Cache::forget("setting:{$key}");

        return $setting;
    }
}
