/* ==========================================================================
   ElevateHer360 Global Styles
   Primary:   #800000
   Secondary: #D4AF37
   ========================================================================== */
.fas,
.fa-solid {
    font-family: "Font Awesome 7 Free", "Font Awesome 6 Free" !important;
    font-weight: 900 !important;
    font-style: normal;
}
:root {
    --primary: #800000;
    --primary-dark: #5f0000;
    --primary-light: #a52a2a;

    --secondary: #d4af37;
    --secondary-dark: #b8941f;
    --secondary-soft: #f7e7a9;

    --background: #fff8f0;
    --background-soft: #fffdf9;
    --surface: #ffffff;
    --surface-muted: #f9fafb;

    --text: #2b2b2b;
    --text-dark: #111827;
    --muted: #6b7280;

    --border: #e5e7eb;
    --border-dark: #d1d5db;

    --success: #15803d;
    --success-bg: #f0fdf4;
    --danger: #b91c1c;
    --danger-bg: #fef2f2;
    --warning: #b45309;
    --warning-bg: #fffbeb;
    --info: #0369a1;
    --info-bg: #f0f9ff;

    --radius-sm: 6px;
    --radius: 10px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 22px;

    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 20px 55px rgba(128, 0, 0, 0.08);

    --transition: 0.2s ease;
}

/* ==========================================================================
   Base
   ========================================================================== */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.5;
}

main {
    overflow-x: hidden;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

a,
a:hover,
a:focus,
a:active {
    text-decoration: none !important;
}

a {
    color: var(--primary);
    transition: color var(--transition), background var(--transition), border-color var(--transition);
}

a:hover,
a:focus {
    color: var(--primary-dark);
}

/* ==========================================================================
   Typography
   ========================================================================== */

h1,
h2,
h3,
h4,
h5,
h6 {
    margin-top: 0;
    color: var(--text-dark);
    line-height: 1.25;
}

h1 {
    font-size: 2.25rem;
}

h2 {
    font-size: 1.75rem;
}

h3 {
    font-size: 1.25rem;
}

p {
    margin-top: 0;
}

.text-muted {
    color: var(--muted);
}

.text-primary {
    color: var(--primary);
}

.text-secondary {
    color: var(--secondary-dark);
}

.text-success {
    color: var(--success);
}

.text-danger {
    color: var(--danger);
}

.text-warning {
    color: var(--warning);
}

.fw-bold {
    font-weight: 700;
}

.fw-extra-bold {
    font-weight: 800;
}

/* ==========================================================================
   Layout
   ========================================================================== */

.container {
    width: min(1180px, calc(100% - 32px));
    margin-inline: auto;
}

.site-main {
    min-height: calc(100vh - 150px);
}

.page-shell {
    width: min(1180px, calc(100% - 32px));
    margin-inline: auto;
    padding: 40px 0 70px;
}

.site-main-home {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.full-width-section {
    width: 100%;
    margin: 0;
}

.site-main-home .full-width-section > .container,
.full-width-section > .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
}

.section {
    padding-block: clamp(70px, 8vw, 100px);
}

.section-light {
    background: #fffaf5;
}

.section-white {
    background: #ffffff;
}

.section-header {
    max-width: 760px;
    margin-bottom: clamp(32px, 4vw, 48px);
}

.section-header h1,
.section-header h2 {
    margin: 8px 0 14px;
}

.section-header p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
}

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.page-header h1 {
    margin-bottom: 6px;
}

.page-header p {
    margin-bottom: 0;
    color: var(--muted);
}

/* ==========================================================================
   Header / Navigation
   ========================================================================== */

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
}

.nav {
    width: min(1180px, calc(100% - 32px));
    min-height: 72px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--primary);
    font-size: 21px;
    font-weight: 800;
}

.brand:hover,
.brand:focus {
    color: var(--primary);
}

.brand-mark {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--primary);
    color: var(--secondary);
    font-size: 13px;
    font-weight: 900;
}

.brand small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
}

.nav-links a {
    color: var(--text-dark);
    font-weight: 600;
}

.nav-links a:hover,
.nav-links a:focus,
.nav-links a.active {
    color: var(--primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

/* ==========================================================================
   Grids
   ========================================================================== */

.grid,
.grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.grid-1 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
}

.grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

/* ==========================================================================
   Cards
   ========================================================================== */

.card {
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
}

.card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
}

.card-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
}

.card-subtitle {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
}

.card-body {
    min-width: 0;
}

.card-footer {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
}

.card-gold {
    border-left-color: var(--secondary);
}

.card-success {
    border-left-color: var(--success);
}

.card-danger {
    border-left-color: var(--danger);
}

.card-warning {
    border-left-color: var(--warning);
}

/* ==========================================================================
   Clickable Feature Cards
   ========================================================================== */

.features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
}

.feature-link {
    display: block;
    height: 100%;
    color: inherit;
}

.feature-link:hover,
.feature-link:focus {
    color: inherit;
}

.feature {
    height: 100%;
    padding: 26px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}

.feature:hover {
    transform: translateY(-4px);
    border-color: var(--secondary);
    box-shadow: var(--shadow-md);
}

.feature-icon {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--secondary-soft);
    color: var(--primary);
    font-size: 20px;
}

.feature h3 {
    margin: 16px 0 8px;
}

.feature p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
}

.feature-arrow {
    margin-top: 18px;
    color: var(--primary);
    font-size: 13px;
    font-weight: 700;
}

.feature-arrow i {
    margin-left: 4px;
}

/* ==========================================================================
   Statistics
   ========================================================================== */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.stat-card {
    min-height: 118px;
    padding: 16px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
}

.stat-card:hover {
    box-shadow: var(--shadow-md);
}

.stat-content {
    min-width: 0;
}

.stat-label {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
}

.stat-value {
    margin-top: 5px;
    color: var(--primary);
    font-size: 1.8rem;
    font-weight: 800;
}

.stat-note {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
}

.stat-icon {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--secondary-soft);
    color: var(--primary);
    font-size: 18px;
}

.stat-card.gold {
    border-left-color: var(--secondary);
}

.stat-card.success {
    border-left-color: var(--success);
}

.stat-card.warning {
    border-left-color: var(--warning);
}

.stat-card.danger {
    border-left-color: var(--danger);
}

/* ==========================================================================
   Buttons
   ========================================================================== */

.btn {
    min-height: 44px;
    padding: 10px 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--primary);
    font-weight: 700;
    transition: transform var(--transition), background var(--transition), color var(--transition), border-color var(--transition);
}

.btn:hover,
.btn:focus {
    transform: translateY(-1px);
}

.btn-primary {
    background: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
}

.btn-primary:hover,
.btn-primary:focus {
    background: var(--primary-dark);
    color: #ffffff;
}

.btn-secondary,
.btn-gold {
    background: var(--secondary);
    color: #2b2100;
    border-color: var(--secondary);
}

.btn-secondary:hover,
.btn-secondary:focus,
.btn-gold:hover,
.btn-gold:focus {
    background: var(--secondary-dark);
    color: #ffffff;
}

.btn-outline {
    background: transparent;
    border-color: var(--primary);
    color: var(--primary);
}

.btn-outline:hover,
.btn-outline:focus {
    background: var(--primary);
    color: #ffffff;
}

.btn-success {
    background: var(--success);
    border-color: var(--success);
    color: #ffffff;
}

.btn-danger {
    background: var(--danger);
    border-color: var(--danger);
    color: #ffffff;
}

.btn-sm {
    min-height: 34px;
    padding: 7px 12px;
    font-size: 0.82rem;
}

.btn-lg {
    min-height: 50px;
    padding: 13px 24px;
}

.btn-block {
    width: 100%;
}

/* ==========================================================================
   Forms
   ========================================================================== */

.form-group {
    margin-bottom: 18px;
}

label {
    display: block;
    margin-bottom: 7px;
    color: var(--text-dark);
    font-size: 14px;
    font-weight: 700;
}

.required::after {
    content: " *";
    color: var(--danger);
}

input,
select,
textarea {
    width: 100%;
    min-height: 46px;
    padding: 11px 13px;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius);
    background: #ffffff;
    color: var(--text);
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
}

textarea {
    min-height: 110px;
    resize: vertical;
}

input::placeholder,
textarea::placeholder {
    color: #9ca3af;
    opacity: 1;
    font-size: 0.87rem;
    font-weight: 400;
}

input:focus::placeholder,
textarea:focus::placeholder {
    color: #c2c5ca;
}

select:invalid {
    color: #9ca3af;
}

select option {
    color: var(--text);
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(128, 0, 0, 0.1);
}

input:disabled,
select:disabled,
textarea:disabled {
    cursor: not-allowed;
    background: #f3f4f6;
    color: #6b7280;
}

.form-help {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.8rem;
}

.input-error {
    border-color: var(--danger);
}

.form-error {
    margin-top: 5px;
    color: var(--danger);
    font-size: 0.8rem;
}

.checkbox-row,
.radio-row {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 12px 0;
}

.checkbox-row input,
.radio-row input {
    width: auto;
    min-height: auto;
    margin-top: 4px;
    accent-color: var(--primary);
}

.checkbox-row label,
.radio-row label {
    margin: 0;
    font-weight: 500;
}

.password-wrap {
    position: relative;
}

.password-wrap input {
    padding-right: 56px;
}

.password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    min-height: auto;
    padding: 6px;
    border: 0;
    background: transparent;
    color: var(--primary);
    font-weight: 700;
}

.password-toggle:hover,
.password-toggle:focus {
    color: var(--primary-dark);
}

/* ==========================================================================
   Alerts / Badges
   ========================================================================== */

.alert,
.error-box,
.success-box,
.warning-box,
.info-box {
    margin-bottom: 20px;
    padding: 14px 16px;
    border-radius: var(--radius);
    border-left: 4px solid;
}

.error-box,
.alert-danger {
    background: var(--danger-bg);
    border-left-color: var(--danger);
    color: #991b1b;
}

.success-box,
.alert-success {
    background: var(--success-bg);
    border-left-color: var(--success);
    color: #166534;
}

.warning-box,
.alert-warning {
    background: var(--warning-bg);
    border-left-color: var(--warning);
    color: #92400e;
}

.info-box,
.alert-info {
    background: var(--info-bg);
    border-left-color: var(--info);
    color: #075985;
}

.alert ul,
.error-box ul {
    margin-bottom: 0;
}

.badge,
.staff-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 999px;
    font-weight: 800;
}

.badge {
    padding: 5px 9px;
    background: #f3f4f6;
    color: var(--text-dark);
    font-size: 0.72rem;
}

.badge-primary {
    background: rgba(128, 0, 0, 0.1);
    color: var(--primary);
}

.badge-gold {
    background: var(--secondary-soft);
    color: #6a4d00;
}

.badge-success {
    background: var(--success-bg);
    color: var(--success);
}

.badge-danger {
    background: var(--danger-bg);
    color: var(--danger);
}

.badge-warning {
    background: var(--warning-bg);
    color: var(--warning);
}

.staff-badge {
    padding: 6px 10px;
    margin-bottom: 16px;
    background: var(--secondary-soft);
    color: #6a4d00;
    font-size: 12px;
}
/* ==========================================================
   ElevateHer360 Authentication Forms
   ========================================================== */

.auth-layout {
    width: min(1180px, calc(100% - 40px));

    min-height: 620px;

    display: grid;

    grid-template-columns:
        minmax(0, 1.05fr)
        minmax(420px, 0.95fr);

    margin: 42px auto;

    overflow: hidden;

    border: 1px solid #eadfda;

    border-radius: 22px;

    background: #ffffff;

    box-shadow:
        0 18px 45px rgba(43, 26, 26, 0.08);
}


/* ==========================================================
   Staff branding side
   ========================================================== */

.auth-side {
    position: relative;

    min-height: 620px;

    display: flex;
    align-items: center;

    padding: 62px 54px;

    background:
        linear-gradient(
            145deg,
            #790000 0%,
            #8c0000 45%,
            #650000 100%
        );

    color: #ffffff;
}

.auth-side::after {
    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    right: -100px;
    bottom: -120px;

    border: 1px solid rgba(212, 175, 55, 0.25);

    border-radius: 50%;
}

.auth-side-content {
    position: relative;

    z-index: 2;

    width: 100%;
    max-width: 500px;
}

.gold-line {
    width: 72px;
    height: 5px;

    margin-bottom: 24px;

    border-radius: 20px;

    background: #d4af37;
}

.staff-badge {
    width: fit-content;

    display: inline-flex;
    align-items: center;

    gap: 7px;

    padding: 7px 11px;

    border-radius: 999px;

    background: #f8e8a7;

    color: #6b5000;

    font-size: 0.72rem;
    font-weight: 800;

    letter-spacing: 0.025em;
}

.auth-side h1 {
    max-width: 500px;

    margin: 26px 0 16px;

    color: #ffffff;

    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.08;

    font-weight: 800;
}

.auth-side > .auth-side-content > p {
    max-width: 470px;

    margin: 0;

    color: rgba(255, 255, 255, 0.76);

    font-size: 0.97rem;
    line-height: 1.7;
}


/* ==========================================================
   Staff benefits
   ========================================================== */

.staff-auth-features {
    display: grid;

    gap: 14px;

    margin-top: 38px;
}

.staff-auth-feature {
    display: flex;
    align-items: flex-start;

    gap: 12px;
}

.staff-auth-feature > span {
    flex: 0 0 auto;

    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    border: 1px solid rgba(255, 255, 255, 0.14);

    border-radius: 9px;

    background: rgba(255, 255, 255, 0.09);

    color: #f1d269;
}

.staff-auth-feature strong {
    display: block;

    margin-bottom: 2px;

    color: #ffffff;

    font-size: 0.82rem;
}

.staff-auth-feature small {
    display: block;

    color: rgba(255, 255, 255, 0.65);

    font-size: 0.73rem;
    line-height: 1.45;
}


/* ==========================================================
   Authentication panel
   ========================================================== */

.auth-panel {
    display: flex;
    align-items: center;

    padding: 54px 50px;

    background: #ffffff;
}

.auth-panel-inner {
    width: 100%;
    max-width: 470px;

    margin: 0 auto;
}

.staff-badge-light {
    margin-bottom: 18px;
}

.auth-heading h2 {
    margin: 0 0 7px;

    color: #800000;

    font-size: 1.8rem;
    font-weight: 750;
}

.auth-heading .subtitle {
    margin: 0 0 22px;

    color: #667085;

    font-size: 0.9rem;
    line-height: 1.55;
}


/* ==========================================================
   Form feedback
   ========================================================== */

.form-feedback {
    width: 100%;

    margin-bottom: 19px;
}

.form-feedback:empty {
    display: none;
}

.form-alert {
    width: 100%;

    display: flex;
    align-items: flex-start;

    gap: 10px;

    padding: 11px 13px;

    border: 1px solid transparent;
    border-radius: 8px;

    font-size: 0.79rem;
    line-height: 1.45;
}

.form-alert-icon {
    flex: 0 0 auto;

    width: 20px;

    margin-top: 1px;

    text-align: center;
}

.form-alert-content {
    flex: 1;
    min-width: 0;
}

.form-alert-content strong {
    display: block;

    margin-bottom: 4px;
}

.form-alert-content ul {
    margin: 5px 0 0 18px;
    padding: 0;
}

.form-alert-success {
    border-color: #abefc6;

    background: #ecfdf3;

    color: #067647;
}

.form-alert-error {
    border-color: #fecdca;

    background: #fef3f2;

    color: #b42318;
}

.form-alert-warning {
    border-color: #fedf89;

    background: #fffaeb;

    color: #93370d;
}

.form-alert-info {
    border-color: #b2ddff;

    background: #eff8ff;

    color: #175cd3;
}


/* ==========================================================
   Five-second fade
   ========================================================== */

.flash-message {
    overflow: hidden;

    max-height: 500px;

    opacity: 1;

    transform: translateY(0);

    transition:
        opacity 0.45s ease,
        transform 0.45s ease,
        max-height 0.45s ease,
        margin 0.45s ease,
        padding 0.45s ease;
}

.flash-message.is-fading {
    opacity: 0;

    transform: translateY(-5px);
}

.flash-message.is-hidden {
    max-height: 0 !important;

    margin-top: 0 !important;
    margin-bottom: 0 !important;

    padding-top: 0 !important;
    padding-bottom: 0 !important;

    border-width: 0 !important;

    opacity: 0;

    pointer-events: none;
}


/* ==========================================================
   Auth fields
   ========================================================== */

.auth-form .form-group {
    margin-bottom: 18px;
}

.auth-form .form-group label {
    display: block;

    margin-bottom: 7px;

    color: #172033;

    font-size: 0.8rem;
    font-weight: 750;
}

.input-with-icon {
    position: relative;
}

.input-leading-icon {
    position: absolute;

    top: 50%;
    left: 13px;

    z-index: 2;

    transform: translateY(-50%);

    color: #98a2b3;

    font-size: 0.84rem;

    pointer-events: none;
}

.auth-form
.input-with-icon
input {
    width: 100%;

    min-height: 46px;

    padding:
        10px
        44px
        10px
        40px;

    border: 1px solid #d0d5dd;

    border-radius: 8px;

    background: #ffffff;

    color: #172033;

    font-family: inherit;
    font-size: 0.88rem;

    outline: none;

    transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease;
}

.auth-form
.input-with-icon
input:focus {
    border-color: #800000;

    box-shadow:
        0 0 0 3px rgba(128, 0, 0, 0.08);
}

.auth-form
.input-with-icon
input.is-invalid {
    border-color: #d92d20;
}

.auth-form
input::placeholder {
    color: #98a2b3;
}

.form-hint {
    display: block;

    margin-top: 6px;

    color: #667085;

    font-size: 0.71rem;
    line-height: 1.4;
}

.field-error {
    display: flex;
    align-items: center;

    gap: 5px;

    margin-top: 6px;

    color: #b42318;

    font-size: 0.71rem;
    font-weight: 650;
}

.required {
    color: #b42318;
}


/* ==========================================================
   Password
   ========================================================== */

.password-wrap {
    position: relative;
}

.password-toggle {
    position: absolute;

    top: 50%;
    right: 10px;

    z-index: 3;

    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    transform: translateY(-50%);

    border: 0;

    border-radius: 7px;

    background: transparent;

    color: #667085;

    cursor: pointer;
}

.password-toggle:hover {
    background: #f4f4f5;

    color: #800000;
}


/* ==========================================================
   Remember option
   ========================================================== */

.remember-option {
    display: flex;
    align-items: flex-start;

    gap: 9px;

    margin: 3px 0 20px;

    cursor: pointer;
}

.remember-option input {
    flex: 0 0 auto;

    margin-top: 3px;
}

.remember-option strong {
    display: block;

    color: #344054;

    font-size: 0.78rem;
}

.remember-option small {
    display: block;

    margin-top: 2px;

    color: #667085;

    font-size: 0.69rem;
}


/* ==========================================================
   Staff submit
   ========================================================== */

.auth-submit {
    width: 100%;

    min-height: 46px;

    margin-top: 2px;

    border-radius: 8px;
}

.staff-security-note {
    display: flex;
    align-items: flex-start;

    gap: 7px;

    margin-top: 15px;

    padding-top: 14px;

    border-top: 1px solid #eaecf0;

    color: #667085;

    font-size: 0.69rem;
    line-height: 1.45;
}

.staff-security-note i {
    margin-top: 2px;

    color: #800000;
}


/* ==========================================================
   Responsive
   ========================================================== */

@media (max-width: 900px) {

    .auth-layout {
        grid-template-columns: 1fr;

        width: min(680px, calc(100% - 28px));

        margin: 24px auto;
    }

    .auth-side {
        min-height: auto;

        padding: 38px 32px;
    }

    .auth-side h1 {
        font-size: 2rem;
    }

    .staff-auth-features {
        display: none;
    }

    .auth-panel {
        padding: 38px 32px;
    }
}

@media (max-width: 520px) {

    .auth-layout {
        width: calc(100% - 20px);

        margin: 14px auto;

        border-radius: 14px;
    }

    .auth-side {
        padding: 28px 22px;
    }

    .auth-panel {
        padding: 28px 20px;
    }

    .auth-heading h2 {
        font-size: 1.55rem;
    }
}

/* ==========================================================================
   Registration
   ========================================================================== */

.registration-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
}

.registration-progress-label {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
}

.registration-progress {
    width: 100%;
    height: 7px;
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: 999px;
    background: #f1f1f1;
}

.registration-progress-bar {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    transition: width 0.3s ease;
}

.registration-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 24px;
}

.registration-tab {
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #ffffff;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
    transition: background var(--transition), color var(--transition), border-color var(--transition), transform var(--transition);
}

.registration-tab:hover {
    border-color: var(--secondary);
    transform: translateY(-1px);
}

.registration-tab.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

.registration-tab.completed {
    background: var(--secondary-soft);
    border-color: var(--secondary);
    color: var(--primary);
}

.tab-number {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f3f4f6;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 800;
}

.registration-tab.active .tab-number {
    background: var(--secondary);
    color: var(--primary-dark);
}

.registration-tab.completed .tab-number {
    background: var(--primary);
    color: #ffffff;
}

.tab-text {
    white-space: nowrap;
}

.registration-step {
    display: none;
}

.registration-step.active {
    display: block;
    animation: registrationFade 0.2s ease;
}

@keyframes registrationFade {
    from {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.step-heading {
    margin-bottom: 24px;
}

.step-heading h3 {
    margin-bottom: 6px;
    color: var(--primary);
}

.step-heading p {
    margin-bottom: 0;
    color: var(--muted);
}

.registration-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
}

.registration-actions button:last-child {
    margin-left: auto;
}

.registration-actions button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

/* ==========================================================================
   Tables
   ========================================================================== */

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
}

thead {
    background: #faf7f2;
}

th,
td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: middle;
}

th {
    color: var(--text-dark);
    font-size: 0.82rem;
    font-weight: 800;
}

td {
    font-size: 0.9rem;
}

tbody tr:hover {
    background: #fffdf9;
}

/* ==========================================================================
   Filters / Tabs
   ========================================================================== */

.filters {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.filter-item {
    min-width: 180px;
    flex: 1;
}

.search-box {
    position: relative;
}

.search-box input {
    padding-left: 40px;
}

.search-icon {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
}

.tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--border);
}

.tab {
    padding: 10px 14px;
    border-bottom: 3px solid transparent;
    color: var(--muted);
    font-weight: 700;
}

.tab:hover,
.tab:focus {
    color: var(--primary);
}

.tab.active {
    border-bottom-color: var(--primary);
    color: var(--primary);
}

/* ==========================================================================
   Dashboard
   ========================================================================== */

.dashboard-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    background: #f9fafb;
}

.sidebar {
    padding: 22px 14px;
    background: var(--primary);
    color: #ffffff;
}

.sidebar-brand {
    padding: 0 10px 22px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

.sidebar-brand strong {
    display: block;
    font-size: 1.15rem;
}

.sidebar-brand small {
    color: var(--secondary-soft);
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    color: #f8e8e8;
    font-size: 0.9rem;
    font-weight: 600;
}

.sidebar-nav a:hover,
.sidebar-nav a:focus,
.sidebar-nav a.active {
    background: rgba(255, 255, 255, 0.12);
    color: var(--secondary);
}

.dashboard-main {
    min-width: 0;
}

.dashboard-topbar {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 24px;
    background: #ffffff;
    border-bottom: 1px solid var(--border);
}

.dashboard-content {
    padding: 24px;
}

/* ==========================================================================
   Progress / Modal / Empty State / Pagination
   ========================================================================== */

.progress {
    width: 100%;
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: #e5e7eb;
}

.progress-bar {
    height: 100%;
    border-radius: inherit;
    background: var(--primary);
}

.progress-bar.gold {
    background: var(--secondary);
}

.progress-bar.success {
    background: var(--success);
}

.progress-bar.warning {
    background: var(--warning);
}

.modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(17, 24, 39, 0.65);
}

.modal {
    width: min(620px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
}

.modal-body {
    padding: 20px;
}

.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 20px;
    border-top: 1px solid var(--border);
}

.empty-state {
    padding: 48px 20px;
    text-align: center;
    color: var(--muted);
}

.empty-state-icon {
    margin-bottom: 12px;
    color: var(--secondary);
    font-size: 42px;
}

.empty-state h3 {
    margin-bottom: 8px;
}

.pagination {
    display: flex;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 22px;
}

.pagination a,
.pagination span {
    min-width: 36px;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #ffffff;
}

.pagination .active,
.pagination span[aria-current="page"] {
    background: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

/* ==========================================================================
   Landing Page
   ========================================================================== */

.hero {
    width: 100%;
    padding-block: clamp(72px, 9vw, 110px);
    background: linear-gradient(180deg, #fff7f4 0%, #ffffff 100%);
}

.hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(380px, 0.9fr);
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
}

.hero-copy {
    max-width: 680px;
}

.eyebrow {
    color: var(--primary);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.hero h1 {
    margin: 16px 0 24px;
    font-size: clamp(48px, 5.5vw, 72px);
    line-height: 1.03;
    letter-spacing: -1.5px;
}

.lead {
    max-width: 650px;
    margin-bottom: 0;
    color: #4b5563;
    font-size: 18px;
    line-height: 1.8;
}

.hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
}

.journey-card {
    width: 100%;
    padding: clamp(28px, 3vw, 36px);
    background: #ffffff;
    border: 1px solid var(--border);
    border-top: 4px solid var(--secondary);
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
}

.journey-card h2 {
    margin: 6px 0 22px;
    font-size: clamp(26px, 2.5vw, 34px);
}

.journey-item {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
    padding: 18px;
    border-radius: 12px;
    background: #f8f8f8;
}

.journey-item .number {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--secondary-soft);
    color: var(--primary);
    font-weight: 800;
}

.impact {
    width: 100%;
    margin: 0;
    padding-block: clamp(72px, 8vw, 100px);
    padding-inline: 0;
    background: #2b0a0a;
    color: #ffffff;
}

.impact h1,
.impact h2,
.impact h3 {
    color: #ffffff;
}

.impact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(44px, 6vw, 72px);
    align-items: center;
}

.impact p {
    color: #eadede;
}

.cta-box {
    margin: 0;
    padding: clamp(34px, 5vw, 52px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    color: #ffffff;
}

.cta-box h2 {
    margin-bottom: 8px;
    color: #ffffff;
}

.cta-box p {
    margin-bottom: 0;
    color: #f8e8e8;
}

/* ==========================================================================
   Flash Messages
   ========================================================================== */

.global-messages {
    padding-top: 20px;
}

.global-messages .alert,
.global-messages .success-box,
.global-messages .error-box,
.global-messages .warning-box,
.global-messages .info-box {
    margin-bottom: 12px;
}

/* ==========================================================================
   Footer
   ========================================================================== */

.site-footer {
    margin-top: 0;
    padding: 30px 0;
    background: #ffffff;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
}

.footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
}

.footer-brand {
    display: block;
    margin-bottom: 4px;
    color: var(--primary);
    font-size: 15px;
    font-weight: 800;
}

.footer-copy {
    color: var(--muted);
    font-size: 13px;
}

.footer-copy i {
    margin-right: 4px;
    color: var(--primary);
}

.footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
}

.footer-links a {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
}

.footer-links a:hover,
.footer-links a:focus {
    color: var(--primary);
}

/* ==========================================================================
   Accessibility
   ========================================================================== */

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.skip-link {
    position: fixed;
    left: 10px;
    top: -100px;
    z-index: 9999;
    padding: 10px 14px;
    background: var(--primary);
    color: #ffffff;
    border-radius: 6px;
}

.skip-link:focus {
    top: 10px;
}

/* ==========================================================================
   Utilities
   ========================================================================== */

.d-flex {
    display: flex;
}

.align-items-center {
    align-items: center;
}

.align-items-start {
    align-items: flex-start;
}

.justify-content-between {
    justify-content: space-between;
}

.justify-content-center {
    justify-content: center;
}

.flex-wrap {
    flex-wrap: wrap;
}

.gap-1 {
    gap: 6px;
}

.gap-2 {
    gap: 10px;
}

.gap-3 {
    gap: 16px;
}

.mt-0 {
    margin-top: 0;
}

.mt-1 {
    margin-top: 8px;
}

.mt-2 {
    margin-top: 16px;
}

.mt-3 {
    margin-top: 24px;
}

.mb-0 {
    margin-bottom: 0;
}

.mb-1 {
    margin-bottom: 8px;
}

.mb-2 {
    margin-bottom: 16px;
}

.mb-3 {
    margin-bottom: 24px;
}

.text-center {
    text-align: center;
}

.w-100 {
    width: 100%;
}

/* ==========================================================================
   Responsive
   ========================================================================== */

@media (max-width: 1100px) {
    .grid-4,
    .stats-grid,
    .features {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-grid,
    .impact-grid {
        grid-template-columns: 1fr;
    }

    .hero-copy {
        max-width: 760px;
    }
}

@media (max-width: 900px) {
    .dashboard-shell {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: none;
    }

    .auth-layout {
        grid-template-columns: 1fr;
    }

    .auth-side {
        min-height: auto;
        padding: 34px;
    }

    .auth-side h1 {
        font-size: 32px;
    }

    .auth-panel {
        padding: 34px;
    }

    .grid,
    .grid-2,
    .grid-3 {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-direction: column;
    }
}

@media (max-width: 760px) {
    .registration-tabs {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .registration-heading {
        flex-direction: column;
    }
}

@media (max-width: 700px) {
    .site-main-home .full-width-section > .container,
    .full-width-section > .container {
        width: calc(100% - 28px);
    }

    .footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .footer-links {
        gap: 12px 18px;
    }
}

@media (max-width: 640px) {
    .container,
    .nav,
    .page-shell {
        width: calc(100% - 20px);
    }

    .nav-links {
        display: none;
    }

    .brand small {
        display: none;
    }

    .auth-panel,
    .auth-side {
        padding: 24px;
    }

    .grid-4,
    .stats-grid,
    .features {
        grid-template-columns: 1fr;
    }

    .section,
    .impact {
        padding-block: 56px;
    }

    .hero {
        padding-block: 56px;
    }

    .hero h1 {
        font-size: 44px;
    }

    .journey-card {
        padding: 22px;
    }

    .cta-box {
        padding: 28px;
        flex-direction: column;
        align-items: flex-start;
    }

    .dashboard-content {
        padding: 16px;
    }

    .dashboard-topbar {
        padding: 0 16px;
    }

    .filters {
        flex-direction: column;
        align-items: stretch;
    }

    .filter-item {
        width: 100%;
    }
}

@media (max-width: 480px) {
    .registration-tab {
        min-height: 46px;
        padding: 7px 8px;
        font-size: 0.78rem;
    }

    .tab-number {
        width: 22px;
        height: 22px;
        flex-basis: 22px;
    }

    .registration-actions {
        flex-wrap: wrap;
    }

    .registration-actions .btn {
        flex: 1 1 auto;
    }
}
/* ==========================================================================
   Impact Section
   ========================================================================== */

.impact {
    width: 100%;
    margin: 0;
    padding-block: clamp(72px, 8vw, 100px);
    background: #2b0a0a;
    color: #ffffff;
}

.impact-intro {
    max-width: 760px;
    margin-bottom: 42px;
}

.impact-eyebrow {
    color: var(--secondary);
}

.impact-intro h2 {
    margin: 8px 0 14px;

    color: #ffffff;

    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.15;
}

.impact-intro p {
    max-width: 720px;

    margin-bottom: 0;

    color: #eadede;

    font-size: 16px;
    line-height: 1.75;
}

.impact-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 18px;
}

.impact-card {
    min-height: 210px;

    padding: 22px;

    background: #ffffff;

    border: 1px solid rgba(212, 175, 55, 0.35);
    border-left: 4px solid var(--secondary);
    border-radius: 14px;

    box-shadow: var(--shadow-sm);
}

.impact-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    margin-bottom: 14px;
}

.impact-card-label {
    color: var(--muted);

    font-size: 0.78rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.impact-card-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--secondary-soft);
    color: var(--primary);

    font-size: 18px;
}

.impact-card-value {
    margin-bottom: 10px;

    color: var(--primary);

    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
}

.impact-card p {
    margin-bottom: 0;

    color: var(--muted);

    font-size: 0.88rem;
    line-height: 1.65;
}

@media (max-width: 1000px) {

    .impact-cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}

@media (max-width: 600px) {

    .impact-intro {
        margin-bottom: 30px;
    }

    .impact-cards {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .impact-card {
        min-height: auto;
    }

}
