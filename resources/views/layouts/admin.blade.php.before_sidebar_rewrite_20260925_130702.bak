<script>
document.addEventListener('DOMContentLoaded',()=>{
 const shell=document.querySelector('.admin-shell');
 document.querySelectorAll('[data-admin-sidebar-toggle]').forEach(b=>b.addEventListener('click',()=>shell?.classList.toggle('admin-sidebar-open')));
 document.querySelector('[data-admin-overlay]')?.addEventListener('click',()=>shell?.classList.remove('admin-sidebar-open'));
 document.querySelectorAll('[data-auto-dismiss]').forEach(m=>setTimeout(()=>{m.classList.add('is-fading');setTimeout(()=>m.remove(),450)},5000));
});
</script>
