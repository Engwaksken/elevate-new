                $itemTitle = data_get($item, 'title') ?? data_get($item, 'name') ?? 'Appraisal Item';
                $itemWeight = data_get($item, 'weight');
                $scoreRecord = $scoreForItem($item);
                $weeklyRows = $weeklyForItem($item);
